{
  "name": "omarsa-ui-propuestas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototipos de front (sin backend) para elegir la biblioteca de UI de la plataforma de contratación.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test:smoke": "playwright test pruebas/smoke.spec.ts",
    "capturas": "playwright test pruebas/capturas.spec.ts",
    "publicar": "node scripts/publicar.mjs",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run test:smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
